# VolatilityHunter cron schedule (UTC container, TZ=America/New_York)
# Weekdays only (Mon-Fri). All times are US/Eastern.

# 09:00 ET - Refresh EOD data and sector map before the market opens.
0 9 * * 1-5 root /usr/bin/flock -n /app/data/vh.lock -c '/app/run_mode.sh fetch' >> /app/logs/cron_fetch.log 2>&1

# 09:35 ET - Health check, then run the daily trading loop.
35 9 * * 1-5 root /usr/bin/flock -n /app/data/vh.lock -c '/app/run_mode.sh trade' >> /app/logs/cron_trade.log 2>&1

# 16:35 ET - Post-market live reconciliation / report.
35 16 * * 1-5 root /usr/bin/flock -n /app/data/vh.lock -c '/app/run_mode.sh report' >> /app/logs/cron_report.log 2>&1
