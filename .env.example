# VolatilityHunter Environment Configuration
# ==========================================
# Copy this file to .env and fill in your actual values.

# Email notifications (Gmail SMTP)
EMAIL_SENDER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_RECIPIENTS=your-email@gmail.com

# Telegram alerting (mirrors email notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Tiingo Professional API
TIINGO_API_KEY=your_tiingo_api_key

# IBKR Paper Trading (live = 7496, paper = 7497)
IBKR_USER_NAME=your_ibkr_username
IBKR_PASSWORD=your_ibkr_password
IBKR_LOGIN_ID=your_ibkr_username
IBKR_TRADING_MODE=paper
TRADING_MODE=paper
IBKR_PORT=7497

# Internal identity
AGENT_ID=volatilityhunter
AGENT_SHARED_SECRET=your_shared_secret

# Optional monitoring server (Flask/FastAPI - not used in cron container)
MONITORING_HOST=0.0.0.0
MONITORING_PORT=8080

# Container runtime defaults
TZ=America/New_York
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
